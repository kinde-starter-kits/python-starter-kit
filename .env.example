# Kinde Flask starter kit
# Copy this file to .env and fill in the values from your Kinde application.
# .env is in .gitignore, so your secrets stay out of git.

# Your Kinde application (App Keys page)
KINDE_CLIENT_ID=<YOUR_CLIENT_ID>
KINDE_CLIENT_SECRET=<YOUR_CLIENT_SECRET>
KINDE_HOST=https://<YOUR_SUBDOMAIN>.kinde.com
KINDE_REDIRECT_URI=http://localhost:5001/callback
# Optional: only if you call your own API with the access token
# KINDE_AUDIENCE=

# Management API (optional, used by the /helpers and /api_demo pages)
KINDE_DOMAIN=<YOUR_SUBDOMAIN>.kinde.com
KINDE_MANAGEMENT_CLIENT_ID=<YOUR_MANAGEMENT_CLIENT_ID>
KINDE_MANAGEMENT_CLIENT_SECRET=<YOUR_MANAGEMENT_CLIENT_SECRET>

# Flask sessions. Generate a key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<YOUR_SECRET_KEY>
# Optional: where session files are kept (a temporary folder is used if not set)
# SESSION_FILE_DIR=./flask_session

# Run on localhost:5001. Port 5000 is used by AirPlay on macOS, and the app must be
# opened on the same host as KINDE_REDIRECT_URI (localhost, not 127.0.0.1).
FLASK_RUN_HOST=localhost
FLASK_RUN_PORT=5001
